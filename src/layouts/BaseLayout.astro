---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Analytics from '../components/Analytics.astro';
import {
  locales,
  defaultLocale,
  htmlLang,
  ogLocale,
  localeFromUrl,
  localePath,
  withBase,
  stripLocale,
  t,
} from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const locale = localeFromUrl(Astro.url);

// OG image: OG01 if the owner supplies it. Otherwise a crop of H01 (demo).
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/photos/*.{jpg,jpeg,png,webp,avif}',
);
const pick = (id: string) =>
  Object.keys(photos).find((p) => p.split('/').pop()?.startsWith(`${id}.`));
const ogKey = pick('OG01') ?? pick('H01');
const og = ogKey
  ? await getImage({
      src: (await photos[ogKey]()).default,
      width: 1200,
      height: 630,
      format: 'jpeg',
      fit: 'cover',
    })
  : undefined;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const basePath = stripLocale(Astro.url.pathname);
const alternates = locales.map((l) => ({
  hreflang: htmlLang[l],
  href: new URL(localePath(l, basePath), Astro.site).href,
}));
const xDefault = new URL(localePath(defaultLocale, basePath), Astro.site).href;
const fullTitle =
  title === 'DECOBROSCREW' ? 'DECOBROSCREW | SDI-TDI DIVING CLUB' : `${title} | DECOBROSCREW`;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex &&
      alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#06101a" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DECOBROSCREW" />
    <meta property="og:locale" content={ogLocale[locale]} />
    {locales
      .filter((l) => l !== locale)
      .map((l) => (
        <meta property="og:locale:alternate" content={ogLocale[l]} />
      ))}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={new URL(og.src, Astro.site).href} />}
    {og && <meta property="og:image:width" content="1200" />}
    {og && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#main" class="skip-link">
      {t(ui.skip, locale)}
    </a>
    <div class="site-shell">
      <SiteHeader />
      <main id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
    <Analytics />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
