---
/* Documents: one column of text with a table of contents built from the document's own h2. */
import BaseLayout from './BaseLayout.astro';
import { localeFromUrl, t } from '../i18n';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const locale = localeFromUrl(Astro.url);
const kicker = t({ ru: 'Документы', en: 'Documents', zh: '文件' }, locale);
const tocLabel = t({ ru: 'Содержание', en: 'Contents', zh: '目录' }, locale);

const html = await Astro.slots.render('default');
const h1 = /<h1[^>]*>([\s\S]*?)<\/h1>/.exec(html)?.[1] ?? title;
const toc: { id: string; text: string }[] = [];
const body = html
  .replace(/<h1[^>]*>[\s\S]*?<\/h1>/, '')
  .replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (_, attrs: string, text: string) => {
    const id = `s${toc.length + 1}`;
    toc.push({ id, text: text.replace(/<[^>]+>/g, '').trim() });
    return `<h2${attrs} id="${id}">${text}</h2>`;
  });
---

<BaseLayout title={title} description={description}>
  <section class="wrap plain-hero">
    <p class="kicker">{kicker}</p>
    <h1 set:html={h1} />
  </section>
  <section class="wrap sec flush legal">
    {toc.length > 0 && (
      <nav class="toc" aria-label={tocLabel}>
        <span class="kicker">{tocLabel}</span>
        {toc.map((s) => (
          <a href={`#${s.id}`}>{s.text}</a>
        ))}
      </nav>
    )}
    <div class="prose" set:html={body} />
  </section>
</BaseLayout>

<script>
  // The section being read is marked in the table of contents.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const mark = (id: string) =>
    links.forEach((a) => a.setAttribute('aria-current', String(a.hash === `#${id}`)));
  if (links.length) {
    mark(links[0].hash.slice(1));
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && mark(e.target.id)),
      { rootMargin: '0px 0px -70% 0px' },
    );
    document.querySelectorAll('.prose h2[id]').forEach((h) => io.observe(h));
  }
</script>

<style is:global>
  .prose {
    overflow-wrap: break-word;
  }
  .prose ul {
    margin: 12px 0 0;
    padding-left: 1.25rem;
    color: #26333e;
  }
  .prose li + li {
    margin-top: 6px;
  }
  .prose .todo {
    color: var(--muted);
    text-decoration: underline dotted var(--signal);
    text-underline-offset: 0.25em;
  }
  .prose p.todo {
    padding: 14px 18px;
    border: 1px dashed var(--signal);
    border-radius: var(--radius-card);
    text-decoration: none;
  }
  .prose a {
    color: var(--blue-deep);
  }
  .plain-hero h1 {
    overflow-wrap: break-word;
    hyphens: auto;
  }
</style>
