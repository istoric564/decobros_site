---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Accordion from '../../components/Accordion.astro';
import { courses, courseBySlug, detailLabels, trainingDisclaimer } from '../../data/training';
import { faq } from '../../data/faq';
import { localeFromUrl, localePath, localeStaticPaths, translator } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = localeFromUrl(Astro.url);
const tr = translator(locale);
const p = (path: string) => localePath(locale, path);
const course = (slug: string) => p(`/training/${slug}`);

const openWater = courseBySlug('open-water-scuba-diver');
const list = ['scuba-discovery', 'advanced-adventure-diver', 'rescue-diver', 'refresher'].map(
  courseBySlug,
);
const specialties = courses.filter((c) => c.category === 'specialty');
const divemaster = courseBySlug('divemaster');
const tech = courses.filter((c) => c.category === 'technical');
const featuredRows = ['minimumAge', 'prerequisites', 'openWater', 'maxDepth', 'price'] as const;

const T = {
  ru: {
    title: 'Обучение дайвингу в Новосибирске',
    description: `Обучение дайвингу SDI и TDI в Новосибирске: ${courses.length} программ от пробного погружения и Open Water до Divemaster и технической подготовки.`,
    kicker: 'Обучение SDI · TDI',
    h1: 'Готовься к следующему шагу.',
    sub: `${courses.length} программ: от первого погружения до технической подготовки. Реальные навыки, а не карточки.`,
    choose: 'Выбрать курс',
    discuss: 'Обсудить обучение',
    subnav: 'Разделы обучения',
    sections: ['Рекреационный дайвинг', 'Профессиональный уровень', 'Технический фундамент'],
    recKicker: 'Рекреационное обучение',
    recH: 'Сначала контроль. Потом глубина.',
    recLead:
      'Обучение строится вокруг реальных навыков: плавучести, трима, работы со снаряжением, планирования и уверенности под водой.',
    featured: 'Фундамент · главный курс',
    specH: 'Специализации: развивай конкретный навык',
    ice: 'подо льдом',
    proH: 'Веди погружение.',
    proLead:
      'SDI Divemaster — первый профессиональный уровень. Когда дайвинг становится ответственностью за других.',
    proBtn: 'Стать Divemaster',
    techKicker: 'Технический фундамент · TDI',
    techH: 'Технический дайвинг начинается не с глубины. Он начинается с дисциплины.',
    step: 'ШАГ',
    techBtn: 'Начать техническую подготовку',
    faqKicker: 'Вопросы',
    faqH: 'Частые вопросы об обучении.',
  },
  en: {
    title: 'Scuba Diving Courses in Novosibirsk',
    description: `SDI and TDI diving courses in Novosibirsk: ${courses.length} programs from a try dive and Open Water to Divemaster and technical training.`,
    kicker: 'SDI · TDI Training',
    h1: 'Train for what comes next.',
    sub: `${courses.length} programs: from a first dive to technical training. Real skills, not cards.`,
    choose: 'Choose a course',
    discuss: 'Discuss training',
    subnav: 'Training sections',
    sections: ['Recreational diving', 'Professional level', 'Technical foundation'],
    recKicker: 'Recreational training',
    recH: 'Control first. Depth later.',
    recLead:
      'Training is built around real skills: buoyancy, trim, equipment handling, planning and confidence underwater.',
    featured: 'Foundation · core course',
    specH: 'Specialties: build a specific skill',
    ice: 'under the ice',
    proH: 'Lead the dive.',
    proLead:
      'SDI Divemaster is the first professional level. When diving becomes responsibility for others.',
    proBtn: 'Become a Divemaster',
    techKicker: 'Technical foundation · TDI',
    techH: 'Technical diving does not start with depth. It starts with discipline.',
    step: 'STEP',
    techBtn: 'Start technical training',
    faqKicker: 'Questions',
    faqH: 'Common questions about training.',
  },
  zh: {
    title: '新西伯利亚潜水培训',
    description: `新西伯利亚 SDI 与 TDI 潜水培训：${courses.length} 个课程，从体验潜水和开放水域到潜水长与技术潜水培训。`,
    kicker: 'SDI · TDI 培训',
    h1: '为下一步做好准备。',
    sub: `${courses.length} 个课程：从第一次潜水到技术潜水培训。真正的技能，而不是证书。`,
    choose: '选择课程',
    discuss: '咨询培训',
    subnav: '培训板块',
    sections: ['休闲潜水', '专业级别', '技术潜水基础'],
    recKicker: '休闲潜水培训',
    recH: '先学控制，再谈深度。',
    recLead: '培训围绕真正的技能展开：浮力、水平姿态、装备操作、潜水计划以及在水下从容应对。',
    featured: '基础 · 核心课程',
    specH: '专项课程：专注提升一项技能',
    ice: '冰下',
    proH: '带领潜水。',
    proLead: 'SDI 潜水长是第一个专业级别。潜水从此意味着对他人负责。',
    proBtn: '成为潜水长',
    techKicker: '技术潜水基础 · TDI',
    techH: '技术潜水不是从深度开始的，而是从纪律开始的。',
    step: '第',
    techBtn: '开始技术潜水培训',
    faqKicker: '常见问题',
    faqH: '关于培训的常见问题。',
  },
}[locale];

const sections = [
  { id: 'recreational', label: T.sections[0] },
  { id: 'professional', label: T.sections[1] },
  { id: 'technical', label: T.sections[2] },
];
const stepLabel = (i: number) =>
  locale === 'zh' ? `第 ${i + 1} 步` : `${T.step} ${String(i + 1).padStart(2, '0')}`;
---

<BaseLayout title={T.title} description={T.description} overlay>
  <PageHero
    imageId="T01"
    kicker={T.kicker}
    title={T.h1}
    sub={T.sub}
    actions={[
      { label: T.choose, href: '#recreational' },
      { label: T.discuss, href: p('/contact') },
    ]}
  />

  <nav class="subnav wrap" aria-label={T.subnav}>
    {sections.map((s, i) => (
      <a href={`#${s.id}`}>
        <span class="mono">{String(i + 1).padStart(2, '0')}</span>
        {s.label}
      </a>
    ))}
  </nav>

  <section class="wrap sec" id="recreational" aria-labelledby="rec-h">
    <div class="two">
      <div>
        <p class="kicker">{T.recKicker}</p>
        <h2 class="h2" id="rec-h">{T.recH}</h2>
      </div>
      <p class="lead">{T.recLead}</p>
    </div>

    <article class="course">
      <div>
        <p class="kicker">{T.featured}</p>
        <h3>{openWater.title}</h3>
        <p class="course-lead">{tr(openWater.headline!)}. {tr(openWater.description)[0]}</p>
        <ul class="chips">
          {tr(openWater.focus).map((f) => (
            <li>{f}</li>
          ))}
        </ul>
        <a class="btn course-btn" href={course(openWater.slug)}>
          {tr(openWater.cta!)}
          <span class="ar" aria-hidden="true">→</span>
        </a>
      </div>
      <dl class="spec-table compact">
        {featuredRows.map((k) => (
          <div>
            <dt>{tr(detailLabels[k])}</dt>
            <dd>{tr(openWater.details[k])}</dd>
          </div>
        ))}
      </dl>
    </article>

    <ul class="course-list">
      {list.map((c) => (
        <li>
          <a href={course(c.slug)}>
            <span class="mono n">{tr(c.eyebrow)}</span>
            <b>{c.title}</b>
            <span class="d">{tr(c.subtitle)}</span>
            <span class="mono v">{c.metric ? tr(c.metric) : '—'}</span>
          </a>
        </li>
      ))}
    </ul>

    <h3 class="sub-h" id="specialties">{T.specH}</h3>
    <ul class="spec-grid">
      {specialties.map((c) => (
        <li>
          <a href={course(c.slug)}>
            <b>{c.title}</b>
            {c.metric && <span class="mono">{tr(c.metric)}</span>}
          </a>
        </li>
      ))}
      <li>
        <a href={p('/ice')}>
          <b>Ice Diver →</b>
          <span class="mono">{T.ice}</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="wrap sec paper" id="professional" aria-labelledby="pro-h">
    <div class="two">
      <div>
        <p class="kicker">{T.sections[1]}</p>
        <h2 class="h2" id="pro-h">{T.proH}</h2>
        <p class="lead sub-lead">{T.proLead}</p>
      </div>
      <div class="pro-card">
        <span class="mono n">SDI DIVEMASTER</span>
        <b>{tr(divemaster.subtitle)}</b>
        <p>{tr(divemaster.description)[0]}</p>
        <a class="btn" href={course(divemaster.slug)}>
          {T.proBtn}
          <span class="ar" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="deep dk" id="technical" aria-labelledby="tech-h">
    <canvas class="sea" data-mode="deep" aria-hidden="true"></canvas>
    <div class="wrap">
      <p class="kicker">{T.techKicker}</p>
      <h2 id="tech-h">{T.techH}</h2>
      <ol class="tech-steps">
        {tech.map((c, i) => (
          <li>
            <span class="mono s">{stepLabel(i)}</span>
            <b>
              <a href={course(c.slug)}>{c.title}</a>
            </b>
            <p>{tr(c.subtitle)}.</p>
            {c.metric && <span class="mono g">{tr(c.metric)}</span>}
          </li>
        ))}
      </ol>
      <a class="btn white tech-btn" href={p('/contact')}>
        {T.techBtn}
        <span class="ar" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="wrap sec" aria-labelledby="faq-h">
    <div class="two">
      <div>
        <p class="kicker">{T.faqKicker}</p>
        <h2 class="h2" id="faq-h">{T.faqH}</h2>
      </div>
      <Accordion items={faq.map((f) => ({ q: tr(f.question), a: tr(f.answer) }))} />
    </div>
    <p class="fine">{tr(trainingDisclaimer)}</p>
  </section>
</BaseLayout>

<script>
  import '../../scripts/sea';
</script>
