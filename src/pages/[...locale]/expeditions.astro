---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import DemoBadge from '../../components/DemoBadge.astro';
import { expeditions, expeditionStatusLabels } from '../../data/expeditions';
import { galleryItems } from '../../data/gallery';
import { localeFromUrl, localePath, localeStaticPaths, t } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = localeFromUrl(Astro.url);
// Preparation on deck: the photo behind "built for the dive" and the call to action.
const prep = galleryItems.find((g) => g.file === 'G-2');

const T = {
  ru: {
    title: 'Экспедиции',
    description:
      'Дайвинг-экспедиции с DECOBROSCREW. Настоящие экспедиции, опытная команда и тщательное планирование.',
    hero: ['Туда, где', 'стоит нырять.'],
    h2: 'Экспедиции',
    empty: '[НУЖЕН КОНТЕНТ: реальные экспедиции с направлением, датами, уровнем и фото]',
    explore: 'Подробнее об экспедиции',
    philH: ['Создано для погружения,', 'а не для буклета.'],
    phil: 'Настоящие экспедиции. Опытная команда. Тщательное планирование. Места, которые того стоят.',
    discuss: 'Обсудить экспедицию',
    discussNote: 'Расскажите о своём опыте и квалификации — подберём поездку и подготовку к ней.',
  },
  en: {
    title: 'Expeditions',
    description:
      'Diving expeditions with DECOBROSCREW. Real expeditions, an experienced crew and careful planning.',
    hero: ['Go somewhere', 'worth diving.'],
    h2: 'Expeditions',
    empty: '[CONTENT REQUIRED: real expeditions with destination, dates, level and photos]',
    explore: 'Explore expedition',
    philH: ['Built for the dive,', 'not the brochure.'],
    phil: 'Real expeditions. Experienced crew. Careful planning. Places that matter.',
    discuss: 'Discuss an expedition',
    discussNote:
      'Tell us about your experience and certification, and we will match a trip and the preparation for it.',
  },
  zh: {
    title: '探险',
    description: '与 DECOBROSCREW 一起潜水探险。真正的探险、经验丰富的团队和周密的计划。',
    hero: ['去往', '值得一潜的地方。'],
    h2: '探险',
    empty: '[需要内容：真实的探险行程，包括目的地、日期、级别和照片]',
    explore: '了解探险详情',
    philH: ['为潜水而生，', '而非为宣传册。'],
    phil: '真正的探险。经验丰富的团队。周密的计划。值得前往的地方。',
    discuss: '咨询探险行程',
    discussNote: '告诉我们您的潜水经验和资质，我们会为您匹配合适的行程和行前准备。',
  },
}[locale];
---

<BaseLayout title={T.title} description={T.description}>
  <Hero imageId="E01" lines={T.hero} />

  <section class="section" aria-labelledby="list-h">
    <div class="container">
      <DemoBadge />
      <h2 id="list-h">{T.h2}</h2>
      <span class="rule"></span>
      {expeditions.length === 0 ? (
        <p class="notice">{T.empty}</p>
      ) : (
        <ul class="list" data-stagger>
          {expeditions.map((e) => (
            <li id={e.slug} class="zoom-media">
              {e.image && (
                <EditorialImage
                  name={e.image}
                  ratio="4 / 3"
                  alt=""
                  sizes="(min-width: 960px) 33vw, 100vw"
                />
              )}
              <p class="eyebrow">{t(e.type, locale)}</p>
              <h3>{t(e.title, locale)}</h3>
              <p class="meta">
                {t(e.destination, locale)}, {t(e.country, locale)}
              </p>
              <p class="meta">
                {t(e.dates, locale)} · {t(e.level, locale)}
              </p>
              <p class="status">{t(expeditionStatusLabels[e.status], locale)}</p>
              <p>{t(e.description, locale)}</p>
              <a class="link-arrow" href={localePath(locale, '/contact')}>
                {T.explore} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="section dark closing" aria-labelledby="phil-h">
    <div class="container split">
      <div class="split-text">
        <h2 id="phil-h">
          {T.philH[0]}
          <br />
          {T.philH[1]}
        </h2>
        <span class="rule"></span>
        <p class="lead">{T.phil}</p>
        <p class="lead note">{T.discussNote}</p>
        <a class="btn light" href={localePath(locale, '/contact')}>
          {T.discuss} <span aria-hidden="true">→</span>
        </a>
      </div>
      {prep && (
        <EditorialImage
          name={`gallery/${prep.file}`}
          ratio="4 / 3"
          alt={prep.alt}
          sizes="(min-width: 960px) 45vw, 100vw"
        />
      )}
    </div>
  </section>
</BaseLayout>

<style>
  h2 {
    font-size: var(--fs-h2);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 32px;
  }
  .list :global(.ei) {
    margin-bottom: 16px;
  }
  h3 {
    font-size: var(--fs-h3);
    margin-block: 8px;
  }
  .meta {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .status {
    margin-block: 10px 12px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
  }
  /* The closing block sits on the ink footer; a deep hairline keeps them apart. */
  .closing {
    border-bottom: 1px solid var(--line-dark);
  }
  .split {
    display: grid;
    gap: 32px;
  }
  .note {
    margin-block: 16px 28px;
  }
  @media (min-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: center;
      gap: clamp(40px, 5vw, 96px);
    }
  }
  @media (min-width: 768px) {
    .list {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 24px;
    }
  }
</style>
