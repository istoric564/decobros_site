---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import { expeditions, expeditionStatusLabels } from '../../data/expeditions';
import { DEMO_CONTENT } from '../../data/site';
import { localeFromUrl, localePath, localeStaticPaths, translator } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = localeFromUrl(Astro.url);
const tr = translator(locale);
const p = (path: string) => localePath(locale, path);

const T = {
  ru: {
    title: 'Дайв-туры и экспедиции из Новосибирска',
    description:
      'Дайвинг-экспедиции с DECOBROSCREW: рэки Красного моря, сеноты Мексики, сафари на Мальдивах. Опытная команда и подготовка к поездке в Новосибирске.',
    kicker: 'Экспедиции',
    h1: 'Туда, где стоит нырять.',
    sub: 'Настоящие экспедиции. Опытная команда. Тщательное планирование. Места, которые того стоят.',
    upcoming: 'Ближайшие поездки',
    listKicker: 'Расписание',
    listH: 'Ближайшие экспедиции.',
    listLead: 'Расскажите о своём опыте и квалификации — подберём поездку и подготовку к ней.',
    demo: 'Даты тестовые.',
    empty: 'Расписание экспедиций появится здесь. Напишите нам — расскажем о ближайших планах.',
    format: 'Формат',
    level: 'Уровень',
    discuss: 'Обсудить экспедицию',
    bandBtn: 'Обсудить экспедицию',
    bandH: 'Создано для погружения, а не для буклета.',
    band: 'Каждая поездка — с подготовкой: какой сертификат нужен, сколько погружений и что потренировать заранее в Новосибирске.',
  },
  en: {
    title: 'Dive Trips and Expeditions from Novosibirsk',
    description:
      'Diving expeditions with DECOBROSCREW: Red Sea wrecks, Mexican cenotes, Maldives liveaboards. An experienced crew and trip preparation in Novosibirsk.',
    kicker: 'Expeditions',
    h1: 'Go somewhere worth diving.',
    sub: 'Real expeditions. Experienced crew. Careful planning. Places that matter.',
    upcoming: 'Upcoming trips',
    listKicker: 'Schedule',
    listH: 'Upcoming expeditions.',
    listLead:
      'Tell us about your experience and certification, and we will match a trip and the preparation for it.',
    demo: 'Dates are test data.',
    empty: 'The expedition schedule will appear here. Write to us to hear about upcoming plans.',
    format: 'Format',
    level: 'Level',
    discuss: 'Discuss this expedition',
    bandBtn: 'Discuss an expedition',
    bandH: 'Built for the dive, not the brochure.',
    band: 'Every trip comes with preparation: which certification you need, how many dives and what to practise in Novosibirsk beforehand.',
  },
  zh: {
    title: '从新西伯利亚出发的潜水之旅与探险',
    description:
      '与 DECOBROSCREW 一起潜水探险：红海沉船、墨西哥天然井、马尔代夫船宿。经验丰富的团队，并在新西伯利亚做好行前准备。',
    kicker: '探险',
    h1: '去往值得一潜的地方。',
    sub: '真正的探险。经验丰富的团队。周密的计划。值得前往的地方。',
    upcoming: '近期行程',
    listKicker: '日程',
    listH: '近期探险。',
    listLead: '告诉我们您的潜水经验和资质，我们会为您匹配合适的行程和行前准备。',
    demo: '日期为测试数据。',
    empty: '探险日程将在此公布。联系我们，了解近期计划。',
    format: '形式',
    level: '级别',
    discuss: '咨询此次探险',
    bandBtn: '咨询探险行程',
    bandH: '为潜水而生，而非为宣传册。',
    band: '每次出行都有行前准备：需要什么认证、多少次潜水，以及出发前在新西伯利亚练习什么。',
  },
}[locale];
---

<BaseLayout title={T.title} description={T.description} overlay>
  <PageHero
    imageId="E01"
    kicker={T.kicker}
    title={T.h1}
    sub={T.sub}
    actions={[{ label: T.upcoming, href: '#exp-list' }]}
  />

  <section class="wrap sec" id="exp-list" aria-labelledby="exp-h">
    <div class="two">
      <div>
        <p class="kicker">{T.listKicker}</p>
        <h2 class="h2" id="exp-h">{T.listH}</h2>
      </div>
      <p class="lead">
        {T.listLead} {DEMO_CONTENT && <span class="ph">{T.demo}</span>}
      </p>
    </div>
    {expeditions.length === 0 ? (
      <p class="notice">{T.empty}</p>
    ) : (
      <ul class="exp-list">
        {expeditions.map((e) => (
          <li class="exp" id={e.slug}>
            <div class="img">
              {e.image && (
                <EditorialImage
                  name={e.image}
                  alt={e.title}
                  fill
                  sizes="(min-width: 1000px) 22vw, (min-width: 640px) 45vw, 100vw"
                />
              )}
            </div>
            <div class="body">
              <div class="row1">
                <span class:list={['pill', e.status === 'completed' ? 'done' : e.status]}>
                  {tr(expeditionStatusLabels[e.status])}
                </span>
                <span class="mono date">{tr(e.dates)}</span>
              </div>
              <h3>{tr(e.title)}</h3>
              <p class="where">
                {tr(e.destination)} · {tr(e.country)}
              </p>
              <p>{tr(e.description)}</p>
              <dl class="mini">
                <div>
                  <dt>{T.format}</dt>
                  <dd>{tr(e.type)}</dd>
                </div>
                <div>
                  <dt>{T.level}</dt>
                  <dd>{tr(e.level)}</dd>
                </div>
              </dl>
              <a class="link" href={p('/contact')}>
                {T.discuss} <span class="ar" aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="band-photo" aria-labelledby="exp-band-h">
    <EditorialImage imageId="H02" fill position="center 40%" />
    <div class="in">
      <h2 id="exp-band-h">{T.bandH}</h2>
      <p>{T.band}</p>
      <a class="btn white band-btn" href={p('/contact')}>
        {T.bandBtn}
        <span class="ar" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
