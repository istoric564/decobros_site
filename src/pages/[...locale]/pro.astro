---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Steps from '../../components/Steps.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import { localeFromUrl, localePath, localeStaticPaths } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = localeFromUrl(Astro.url);
const p = (path: string) => localePath(locale, path);

const T = {
  ru: {
    title: 'Для профи и бизнеса',
    description:
      'Аудит дайв-центров, независимая оценка навыков инструкторов, консультации и сложные погружения под задачу от команды технических дайверов DECOBROSCREW.',
    eyebrow: 'Для профессионалов и дайв-центров',
    hero: ['Независимая', 'экспертиза.'],
    heroCopy: [
      'Аудит дайв-центров, оценка инструкторов и консультации',
      'от команды технических дайверов.',
    ],
    cta: 'Обсудить задачу',
    secondary: 'Техническое обучение',
    servicesEyebrow: 'Что мы делаем',
    servicesH: 'Четыре задачи, с которыми к нам приходят.',
    resultLabel: 'Результат',
    services: [
      [
        'Аудит дайв-центра',
        'Смотрим, как центр работает на самом деле: процедуры безопасности и план действий в аварийной ситуации, состояние снаряжения и газа, организацию погружений, документацию.',
        'Список рисков по приоритету и понятный план исправлений.',
      ],
      [
        'Оценка навыков инструкторов',
        'Практическая проверка в воде и на суше: демонстрация навыков, контроль группы, действия в нештатной ситуации, качество брифингов.',
        'Независимое заключение — для найма, внутреннего контроля или развития команды.',
      ],
      [
        'Консультации и процедуры',
        'Конфигурация снаряжения, планирование технических погружений, газовые смеси, внутренние стандарты и чек-листы.',
        'Рабочие процедуры, адаптированные под ваш центр или команду.',
      ],
      [
        'Сложные погружения под задачу',
        'Пещеры, рэки, подлёдные погружения, индивидуальные экспедиции: планирование, логистика и сопровождение командой.',
        'Погружение, подготовленное как экспедиция.',
      ],
    ],
    note: 'Аудит и оценка навыков — независимое экспертное заключение команды DECOBROSCREW. Они не заменяют аттестацию, сертификацию или контроль качества учебных агентств.',
    howEyebrow: 'Как мы работаем',
    howH: 'От задачи до заключения.',
    how: [
      ['Задача', 'Рассказываете, что нужно проверить или решить и почему это важно сейчас.'],
      ['План', 'Согласуем объём, формат, сроки и стоимость до начала работы.'],
      ['Работа на месте', 'Работаем в вашем центре: на воде, на берегу и с документами.'],
      [
        'Заключение',
        'Выводы и рекомендации по приоритету; при необходимости — повторная проверка.',
      ],
    ],
    closeH: ['Опишите', 'задачу.'],
    close:
      'Для дайв-центров, клубов и профессиональных дайверов. Напишите, что нужно, — ответим, как можем помочь и кто из команды возьмётся.',
    closeCta: 'Связаться',
  },
  en: {
    title: 'For Pros and Business',
    description:
      'Dive center audits, independent instructor skills assessment, consulting and demanding dives to order from the DECOBROSCREW crew of technical divers.',
    eyebrow: 'For professionals and dive centers',
    hero: ['Independent', 'expertise.'],
    heroCopy: [
      'Dive center audits, instructor assessment and consulting',
      'from a crew of technical divers.',
    ],
    cta: 'Discuss your task',
    secondary: 'Technical training',
    servicesEyebrow: 'What we do',
    servicesH: 'Four jobs people bring to us.',
    resultLabel: 'Outcome',
    services: [
      [
        'Dive center audit',
        'We look at how the center really works: safety procedures and the emergency action plan, gear and gas condition, dive operations, documentation.',
        'A prioritized list of risks and a clear plan to fix them.',
      ],
      [
        'Instructor skills assessment',
        'A practical check in the water and on land: skill demonstrations, group control, response to incidents, quality of briefings.',
        'An independent opinion — for hiring, internal control or team development.',
      ],
      [
        'Consulting and procedures',
        'Gear configuration, technical dive planning, gas mixes, internal standards and checklists.',
        'Working procedures adapted to your center or team.',
      ],
      [
        'Demanding dives to order',
        'Caves, wrecks, ice dives, private expeditions: planning, logistics and support from the crew.',
        'A dive prepared like an expedition.',
      ],
    ],
    note: 'Audits and skills assessments are an independent expert opinion of the DECOBROSCREW crew. They do not replace the certification, accreditation or quality control of training agencies.',
    howEyebrow: 'How we work',
    howH: 'From task to findings.',
    how: [
      ['Task', 'You tell us what needs checking or solving and why it matters now.'],
      ['Plan', 'We agree scope, format, timing and price before any work starts.'],
      ['On site', 'We work at your center: in the water, on shore and with the paperwork.'],
      ['Findings', 'Prioritized conclusions and recommendations; a follow-up check if needed.'],
    ],
    closeH: ['Tell us', 'the task.'],
    close:
      'For dive centers, clubs and professional divers. Write what you need, and we will tell you how we can help and who on the crew will take it on.',
    closeCta: 'Get in touch',
  },
  zh: {
    title: '专业与企业服务',
    description:
      'DECOBROSCREW 技术潜水团队提供潜水中心审核、独立的教练技能评估、咨询以及按需定制的高难度潜水。',
    eyebrow: '面向专业潜水员和潜水中心',
    hero: ['独立的', '专业评估。'],
    heroCopy: ['潜水中心审核、教练评估与咨询，', '由技术潜水团队提供。'],
    cta: '讨论您的需求',
    secondary: '技术潜水培训',
    servicesEyebrow: '我们做什么',
    servicesH: '客户找我们解决的四类问题。',
    resultLabel: '成果',
    services: [
      [
        '潜水中心审核',
        '我们查看中心的真实运营情况：安全流程与应急预案、装备和气体状况、潜水组织、文件资料。',
        '按优先级排列的风险清单和清晰的整改计划。',
      ],
      [
        '教练技能评估',
        '水中与陆上的实际考核：技能示范、团队控制、突发情况处置、简报质量。',
        '独立评估意见——用于招聘、内部管控或团队发展。',
      ],
      [
        '咨询与流程',
        '装备配置、技术潜水计划、混合气体、内部标准和检查清单。',
        '为您的中心或团队量身定制的工作流程。',
      ],
      [
        '按需定制的高难度潜水',
        '洞穴、沉船、冰潜、私人探险：由团队负责计划、后勤和全程保障。',
        '像探险一样精心准备的潜水。',
      ],
    ],
    note: '审核和技能评估是 DECOBROSCREW 团队的独立专家意见，不能替代培训机构的认证、资质评定或质量管控。',
    howEyebrow: '工作方式',
    howH: '从需求到结论。',
    how: [
      ['需求', '告诉我们需要检查或解决什么，以及为什么现在很重要。'],
      ['计划', '开始前确定范围、形式、时间和费用。'],
      ['现场工作', '在您的中心开展工作：水中、岸上以及文件资料。'],
      ['结论', '按优先级给出结论和建议；如有需要，进行复查。'],
    ],
    closeH: ['告诉我们', '您的需求。'],
    close:
      '面向潜水中心、俱乐部和专业潜水员。写下您的需求，我们会告诉您能提供哪些帮助，以及由团队中的哪位负责。',
    closeCta: '联系我们',
  },
}[locale];
---

<BaseLayout title={T.title} description={T.description}>
  <Hero
    imageId="PRO01"
    eyebrow={T.eyebrow}
    lines={T.hero}
    copy={T.heroCopy}
    cta={{ label: T.cta, href: p('/contact') }}
    secondary={{ label: T.secondary, href: p('/training#technical') }}
  />

  <section class="section" aria-labelledby="services-h">
    <div class="container">
      <p class="eyebrow">{T.servicesEyebrow}</p>
      <h2 id="services-h">{T.servicesH}</h2>
      <span class="rule"></span>
      <ol class="services" data-stagger>
        {T.services.map(([title, copy, result], i) => (
          <li>
            <span class="n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{title}</h3>
            <p class="copy">{copy}</p>
            <p class="result">
              <span class="eyebrow">{T.resultLabel}</span>
              {result}
            </p>
          </li>
        ))}
      </ol>
      <p class="notice">{T.note}</p>
    </div>
  </section>

  <section class="section paper" aria-labelledby="how-h">
    <div class="container">
      <p class="eyebrow">{T.howEyebrow}</p>
      <h2 id="how-h">{T.howH}</h2>
      <span class="rule"></span>
      <Steps items={T.how.map(([title, copy]) => ({ title, copy }))} />
    </div>
  </section>

  <ClosingCta
    id="close-h"
    heading={T.closeH}
    lead={T.close}
    cta={{ label: T.closeCta, href: p('/contact') }}
  />
</BaseLayout>

<style>
  h2 {
    font-size: var(--fs-h2);
  }
  .eyebrow {
    margin-bottom: 16px;
  }
  .services {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .services li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 8px 12px;
    padding-block: 28px;
    border-bottom: 1px solid var(--line);
  }
  .services .n {
    grid-row: span 3;
    padding-top: 0.5em;
    font-size: 0.8125rem;
    font-weight: 500;
    /* Deep blue keeps AA contrast on paper as well as white. */
    color: #1f5f86;
    font-variant-numeric: tabular-nums;
  }
  .services h3 {
    font-size: var(--fs-h3);
  }
  .copy {
    max-width: 38rem;
    color: var(--muted);
    text-wrap: pretty;
  }
  .result {
    max-width: 38rem;
    text-wrap: pretty;
  }
  .result .eyebrow {
    display: block;
    margin-bottom: 4px;
  }
  @media (min-width: 960px) {
    .services li {
      grid-template-columns: 3.5rem minmax(0, 0.9fr) minmax(0, 1.1fr) minmax(0, 0.8fr);
      gap: 32px;
      align-items: start;
    }
    .services .n {
      grid-row: auto;
    }
    .result .eyebrow {
      margin-bottom: 8px;
    }
  }
</style>
