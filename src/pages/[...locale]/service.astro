---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Closing from '../../components/Closing.astro';
import { address, hours } from '../../data/site';
import { localeFromUrl, localePath, localeStaticPaths, t } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = localeFromUrl(Astro.url);
const p = (path: string) => localePath(locale, path);
const where = `${t(address.short, locale)}, ${t(hours[0].days, locale)} ${t(hours[0].time, locale)}`;

const T = {
  ru: {
    title: 'Ремонт и обслуживание регуляторов в Новосибирске',
    description:
      'Обслуживание и ремонт дайверского снаряжения в Новосибирске: регуляторы, компенсаторы (BCD), сухие и мокрые гидрокостюмы. Сервисная сертификация Apeks.',
    kicker: 'Мастерская DECOBROSCREW',
    h1: 'Снаряжение, которому можно доверять.',
    sub: 'Обслуживание и ремонт регуляторов, BCD и гидрокостюмов всех типов. Сервисная сертификация Apeks.',
