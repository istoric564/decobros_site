    cardLead:
      'После обслуживания вы получаете карту работ: что разобрали, что заменили, что проверили. Регулятор возвращается готовым к воде.',
    cardTitle: 'Карта обслуживания',
    cardWhat: 'регулятор',
    cardExample: 'пример',
