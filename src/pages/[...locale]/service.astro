      ['Первая ступень', 'Разборка, мойка, замена ремкомплекта', 'ремкомплект'],
      ['Промежуточное давление', 'Проверка и настройка по паспорту', 'по паспорту'],
      ['Вторая ступень и октопус', 'Усилие вдоха, клапан выдоха', 'тест'],
      ['Манометр и шланги', 'Точность показаний, осмотр шлангов', 'осмотр'],
      ['Проверка на герметичность', 'Вся система под давлением', 'утечек нет'],
    ],
    cardFoot: ['Готов к воде', 'Подпись мастера · дата'],
    whatKicker: 'Что мы обслуживаем',
    whatH: 'Всё, от чего зависит погружение.',
    what: [
      [
        '01 · РЕГ',
        'Регуляторы',
        'Плановое обслуживание и ремонт первых и вторых ступеней, октопусов, манометров и шлангов. Все типы и производители.',
      ],
      [
        '02 · BCD',
        'Компенсаторы и крылья',
        'Инфляторы, клапаны стравливания, утечки воздуха, мешки и крепления. После ремонта проверяем на герметичность.',
