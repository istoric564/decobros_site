      ],
      [
        '02 · BCD',
        '浮力控制装置与背飞',
        '充气阀、排气阀、漏气、气囊和背带。每次维修后都进行气密性测试。',
      ],
      ['03 · 潜水服', '潜水服', '干式、湿式和半干式：更换腕部和颈部密封圈、拉链、阀门，修补破洞和接缝。'],
      ['04 · 气瓶', '气瓶', '通过可靠的合作方进行检验。把气瓶交给我们，其余由我们安排。'],
    ],
    apeks: 'Apeks 维修认证',
    apeksNote: 'Apeks 是其所有者的商标。',
    whyKicker: '为什么重要',
    whyH: '调节器是您赖以呼吸的装备。',
    why: '膜片和密封件的磨损从外面看不出来，却会在水下显现。因此调节器和浮力控制装置至少每年保养一次——这也是与我们一起潜水的条件。',
    wave: ['吸气 · 呼气', '每一次呼吸都经过一级头和二级头'],
    stepsKicker: '维修流程',
    stepsH: '从故障到下水的四个步骤。',
    steps: [
      ['送来', `直接送到俱乐部：${where}。`],
      ['诊断', '我们检查并测试装备，找到根本原因，而不只是表面症状。'],
      ['确认', '开工前确认维修范围、费用和时间。没有意外。'],
      ['维修与测试', '维修、测试，交还时装备即可下水。'],
    ],
    closeKicker: '维修工坊',
    closeH: '赛季前或探险前？',
    close:
      '请提前送来装备，以便有时间全面检查并在需要时更换零件。告诉我们出了什么问题，我们会建议从哪里开始。',
    closeBtn: '联系我们',
  },
}[locale];
---

<BaseLayout title={T.title} description={T.description} overlay>
  <PageHero
    imageId="SRV01"
    kicker={T.kicker}
    title={T.h1}
    sub={T.sub}
    actions={[
      { label: T.bring, href: p('/contact') },
      { label: T.how, href: '#ws-steps' },
    ]}
  />

  <section class="ws-card wrap" aria-labelledby="ws-card-h">
    <div>
      <p class="kicker">{T.cardKicker}</p>
      <h2 class="h2" id="ws-card-h">{T.cardH}</h2>
      <p class="lead">{T.cardLead}</p>
    </div>
    <div class="card" id="svc">
      <div class="top">
        <span><b>{T.cardTitle}</b> · {T.cardWhat}</span>
        <span class="ph">{T.cardExample}</span>
      </div>
      <ol>
        {T.card.map(([b, s, v]) => (
          <li>
            <b>{b}</b>
            <span>{s}</span>
            <span class="v">{v}</span>
            <span class="ok" aria-hidden="true"></span>
          </li>
        ))}
      </ol>
      <div class="foot">
        <span>{T.cardFoot[0]}</span>
        <span>{T.cardFoot[1]}</span>
      </div>
    </div>
  </section>

  <section class="what wrap" aria-labelledby="ws-what-h">
    <p class="kicker">{T.whatKicker}</p>
    <h2 class="h2" id="ws-what-h">{T.whatH}</h2>
    <ul class="what-list">
      {T.what.map(([n, h, d]) => (
        <li>
          <span class="n">{n}</span>
          <h3>{h}</h3>
          <p>{d}</p>
        </li>
      ))}
    </ul>
    <p class="apeks"><b>{T.apeks}</b><span>{T.apeksNote}</span></p>
  </section>

  <section class="breath dk" aria-labelledby="ws-why-h">
    <canvas class="sea" data-mode="deep" aria-hidden="true"></canvas>
    <div class="wrap">
      <p class="kicker">{T.whyKicker}</p>
      <h2 id="ws-why-h">{T.whyH}</h2>
      <p class="lead">{T.why}</p>
      <div class="wave">
        <canvas id="wave" aria-hidden="true"></canvas>
        <div class="lbl"><span>{T.wave[0]}</span><span>{T.wave[1]}</span></div>
      </div>
    </div>
  </section>

  <section class="steps wrap" id="ws-steps" aria-labelledby="ws-steps-h">
    <p class="kicker">{T.stepsKicker}</p>
    <h2 class="h2" id="ws-steps-h">{T.stepsH}</h2>
    <ol class="step-list">
      {T.steps.map(([b, d]) => (
        <li>
          <b>{b}</b>
          <p>{d}</p>
        </li>
      ))}
    </ol>
  </section>

  <Closing
    kicker={T.closeKicker}
    heading={T.closeH}
    text={T.close}
    action={{ label: T.closeBtn, href: p('/contact') }}
  />
</BaseLayout>

<script>
  import '../../scripts/sea';
  import '../../scripts/workshop';
</script>
