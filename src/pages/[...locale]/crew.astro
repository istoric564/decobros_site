---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import { people, values } from '../../data/crew';
import { DEMO_CONTENT } from '../../data/site';
import { localeFromUrl, localeStaticPaths, translator } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = localeFromUrl(Astro.url);
const tr = translator(locale);

const T = {
  ru: {
    title: 'Команда',
    description:
      'Инструкторы и дайверы DECOBROSCREW. Реальные люди, реальные квалификации, одна команда.',
    kicker: 'Команда',
    h1: 'Важно, с кем ты ныряешь.',
    sub: 'Инструкторы и дайверы DECOBROSCREW. Реальные люди, реальные квалификации, одна команда.',
    listKicker: 'Инструкторы',
    listH: 'Кто будет рядом под водой.',
    demo: 'Все имена и цифры пока тестовые.',
    lead: 'Портреты, квалификации и опыт каждого — до запуска сайта.',
    empty: 'Здесь появятся инструкторы и дайверы команды.',
    qualifications: 'Квалификация',
    experience: 'Опыт',
    specialties: 'Специализация',
    languages: 'Языки',
    valuesKicker: 'Наши ценности',
    valuesH: 'Как мы работаем вместе.',
    sep: ', ',
  },
  en: {
    title: 'The Crew',
    description:
      'Meet the DECOBROSCREW instructors and divers. Real people, real qualifications, one team.',
    kicker: 'The Crew',
    h1: 'The people you dive with matter.',
    sub: 'DECOBROSCREW instructors and divers. Real people, real qualifications, one team.',
    listKicker: 'Instructors',
    listH: 'Who will be beside you underwater.',
    demo: 'All names and numbers are test data for now.',
    lead: 'Portraits, qualifications and experience for everyone — before launch.',
    empty: 'Crew instructors and divers will appear here.',
    qualifications: 'Qualifications',
    experience: 'Experience',
    specialties: 'Specialties',
    languages: 'Languages',
    valuesKicker: 'Our values',
    valuesH: 'How we work together.',
    sep: ', ',
  },
  zh: {
    title: '团队',
    description: '认识 DECOBROSCREW 的教练和潜水员。真实的人，真实的资质，一个团队。',
    kicker: '团队',
    h1: '与谁同潜，至关重要。',
    sub: 'DECOBROSCREW 的教练和潜水员。真实的人，真实的资质，一个团队。',
    listKicker: '教练',
    listH: '谁会在水下陪伴您。',
    demo: '所有姓名和数字目前均为测试数据。',
    lead: '每个人的肖像、资质和经验将在网站上线前提供。',
    empty: '团队的教练和潜水员将在此展示。',
    qualifications: '资质',
    experience: '经验',
    specialties: '专长',
    languages: '语言',
    valuesKicker: '我们的价值观',
    valuesH: '我们如何合作。',
    sep: '、',
  },
}[locale];
---

<BaseLayout title={T.title} description={T.description} overlay>
  <PageHero imageId="C01" kicker={T.kicker} title={T.h1} sub={T.sub} />

  <section class="wrap sec" aria-labelledby="crew-h">
    <div class="two">
      <div>
        <p class="kicker">{T.listKicker}</p>
        <h2 class="h2" id="crew-h">{T.listH}</h2>
      </div>
      <p class="lead">
        {DEMO_CONTENT && <span class="ph">{T.demo}</span>} {T.lead}
      </p>
    </div>
    {people.length === 0 ? (
      <p class="notice">{T.empty}</p>
    ) : (
      <ul class="crew-grid">
        {people.map((m) => (
          <li class="person" id={m.slug}>
            <div class="img">
              {m.portrait && (
                <EditorialImage
                  name={m.portrait}
                  alt={m.name}
                  fill
                  sizes="(min-width: 1100px) 25vw, (min-width: 560px) 50vw, 100vw"
                />
              )}
            </div>
            <h3>{tr(m.name)}</h3>
            <p class="role">{tr(m.role)}</p>
            <dl class="mini">
              <div>
                <dt>{T.qualifications}</dt>
                <dd>{tr(m.qualifications).join(T.sep)}</dd>
              </div>
              <div>
                <dt>{T.experience}</dt>
                <dd>{tr(m.experience)}</dd>
              </div>
              <div>
                <dt>{T.specialties}</dt>
                <dd>{tr(m.specialties).join(T.sep)}</dd>
              </div>
              <div>
                <dt>{T.languages}</dt>
                <dd>{tr(m.languages).join(T.sep)}</dd>
              </div>
            </dl>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="wrap sec paper" aria-labelledby="values-h">
    <p class="kicker">{T.valuesKicker}</p>
    <h2 class="h2" id="values-h">{T.valuesH}</h2>
    <ul class="values">
      {values.map((v) => (
        <li>
          <b>{tr(v.name)}</b>
          <p>{tr(v.text)}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
