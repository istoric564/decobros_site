---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import { galleryCategories, galleryCategoryLabels, galleryItems } from '../../data/gallery';
import { DEMO_CONTENT } from '../../data/site';
import { localeFromUrl, localeStaticPaths, translator } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = localeFromUrl(Astro.url);
const tr = translator(locale);

const T = {
  ru: {
    title: 'Галерея',
    description: 'Галерея DECOBROSCREW. Люди, места и погружения. История нашей команды.',
    kicker: 'Галерея',
    h1: 'Под поверхностью.',
    sub: 'Люди. Места. Погружения. История нашей команды.',
    h2: 'Фотогалерея',
    empty: 'Здесь появятся фотографии команды, выездов и погружений.',
    filter: 'Фильтр фотографий',
    open: 'Открыть фото',
    viewer: 'Просмотр фото',
    close: 'Закрыть просмотр',
    prev: 'Предыдущее фото',
    next: 'Следующее фото',
    hint: 'По клику фото открывается на весь экран: стрелки ← →, Esc закрывает.',
    demo: 'Фото — демо.',
  },
  en: {
    title: 'Gallery',
    description: 'DECOBROSCREW gallery. People, places and dives. The story of our crew.',
    kicker: 'Gallery',
    h1: 'Below the surface.',
    sub: 'People. Places. Dives. The story of our crew.',
    h2: 'Photo gallery',
    empty: 'Photos of the crew, trips and dives will appear here.',
    filter: 'Filter photos',
    open: 'Open photo',
    viewer: 'Photo viewer',
    close: 'Close viewer',
    prev: 'Previous photo',
    next: 'Next photo',
    hint: 'Click a photo to open it full screen: arrows ← →, Esc closes.',
    demo: 'Demo photos.',
  },
  zh: {
    title: '图库',
    description: 'DECOBROSCREW 图库。人物、地点与潜水——我们团队的故事。',
    kicker: '图库',
    h1: '水面之下。',
    sub: '人物。地点。潜水。我们团队的故事。',
    h2: '照片图库',
    empty: '团队、出行和潜水的照片将在此展示。',
    filter: '筛选照片',
    open: '打开照片',
    viewer: '照片查看器',
    close: '关闭查看器',
    prev: '上一张',
    next: '下一张',
    hint: '点击照片可全屏查看：方向键 ← →，Esc 关闭。',
    demo: '演示照片。',
  },
}[locale];

// Wide tiles are spread through the list so the four-column grid closes without holes.
const n = galleryItems.length;
const wideCount = n > 4 ? (4 - (n % 4)) % 4 || 4 : 0;
const wide = new Set(Array.from({ length: wideCount }, (_, k) => Math.round((k * n) / wideCount)));
---

<BaseLayout title={T.title} description={T.description} overlay>
  <PageHero imageId="G01" short kicker={T.kicker} title={T.h1} sub={T.sub} />

  <section class="wrap sec" aria-labelledby="g-h">
    <h2 id="g-h" class="sr-only">{T.h2}</h2>
    {n === 0 ? (
      <p class="notice">{T.empty}</p>
    ) : (
      <>
        <div class="filters" role="group" aria-label={T.filter}>
          {galleryCategories.map((c, i) => (
            <button type="button" class="chip" data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'}>
              {tr(galleryCategoryLabels[c])}
            </button>
          ))}
        </div>
        <ul class="gal" id="grid" data-filter="All">
          {galleryItems.map((g, i) => {
            const alt = tr(g.alt);
            return (
              <li data-category={g.category} class:list={{ w2: wide.has(i) }}>
                <button
                  type="button"
                  class="open"
                  aria-label={`${T.open}: ${alt || tr(galleryCategoryLabels[g.category])}`}
                >
                  <EditorialImage
                    name={`gallery/${g.file}`}
                    alt={alt}
                    fill
                    sizes={wide.has(i) ? '(min-width: 900px) 50vw, 100vw' : '(min-width: 900px) 25vw, 50vw'}
                  />
                </button>
              </li>
            );
          })}
        </ul>
        <p class="fine">
          {T.hint} {DEMO_CONTENT && <span class="ph">{T.demo}</span>}
        </p>
        <dialog id="viewer" aria-label={T.viewer}>
          <button type="button" class="close" aria-label={T.close}>×</button>
          <button type="button" class="nav prev" aria-label={T.prev}>‹</button>
          <div class="stage"></div>
          <button type="button" class="nav next" aria-label={T.next}>›</button>
        </dialog>
      </>
    )}
  </section>
</BaseLayout>

<script>
  import '../../scripts/gallery';
</script>

<style>
  .gal li[hidden] {
    display: none;
  }
  .open {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  dialog {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(6 16 26 / 97%);
    color: var(--white);
  }
  dialog::backdrop {
    background: #000;
  }
  .stage {
    position: absolute;
    inset: 64px 56px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .stage :global(img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .close,
  .nav {
    position: absolute;
    z-index: 2;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(255 255 255 / 30%);
    border-radius: 4px;
    background: transparent;
    color: var(--white);
    font: 300 1.75rem/1 var(--sans);
    cursor: pointer;
    transition: background 0.3s;
  }
  .close:hover,
  .nav:hover {
    background: rgb(255 255 255 / 14%);
  }
  .close {
    top: 8px;
    right: 8px;
  }
  .nav {
    top: 50%;
    transform: translateY(-50%);
  }
  .prev {
    left: 4px;
  }
  .next {
    right: 4px;
  }
</style>
