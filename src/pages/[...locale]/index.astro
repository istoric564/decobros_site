---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/home.css';
import Hero from '../../components/Hero.astro';
import Band from '../../components/Band.astro';
import Steps from '../../components/Steps.astro';
import ClosingCta from '../../components/ClosingCta.astro';
import EditorialImage from '../../components/EditorialImage.astro';
import { localeFromUrl, localePath, localeStaticPaths } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const locale = localeFromUrl(Astro.url);
const p = (path: string) => localePath(locale, path);

const T = {
  ru: {
    description:
      'DECOBROSCREW — команда подводных решений из Новосибирска: пробные погружения, обучение SDI и TDI, экспедиции, мастерская снаряжения, аудит дайв-центров.',
    hero: ['Хочешь', 'под воду?'],
    heroCopy: [
      'Попробовать. Научиться. Увидеть мант.',
      'Починить регулятор. Проверить дайв-центр.',
      'Всё, что под водой, — к нам.',
    ],
    heroCta: 'Попробовать впервые',
    heroSecondary: 'Я уже ныряю',
    wantEyebrow: 'С чего начать',
    wantH: 'Что вы хотите сделать под водой?',
    want: [
      ['Попробовать впервые', 'Бассейн или открытая вода, инструктор рядом, опыт не нужен.'],
      ['Научиться и получить сертификат', 'Open Water с нуля: теория, бассейн, открытая вода.'],
