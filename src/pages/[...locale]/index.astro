---

<BaseLayout title="DECOBROSCREW" description={T.description} home overlay>
  <section class="hero" data-depth="0">
    <EditorialImage imageId="H01" fill priority position="62% center" />
    <div class="copy">
      <p class="kicker">{T.hero.kicker}</p>
      <h1>{T.hero.h1}</h1>
      <p class="sub">{T.hero.sub}</p>
      <div class="acts">
        <a class="btn white" href={p('/try')}>
          {T.hero.try}{' '}
          <span class="ar" aria-hidden="true">
            →
          </span>
        </a>
        <a class="btn out" href="#doors">
          {T.hero.diver}
        </a>
      </div>
      <p class="reply">
        <span class="dot" aria-hidden="true"></span>
        <span class="ph">{T.hero.reply}</span>
        <span aria-hidden="true">·</span>
        <span class="mono">{T.facts[3][0]}</span>
      </p>
    </div>
  </section>

  <div class="facts">
    {T.facts.map(([b, s]) => (
      <div>
        <b>{b}</b>
        <span>{s}</span>
      </div>
    ))}
  </div>

  <section class="doors wrap" id="doors" data-depth="0" aria-labelledby="doors-h">
    <p class="kicker">{T.doors.kicker}</p>
    <h2 class="h2" id="doors-h">
      {T.doors.h2}
    </h2>
    <ol class="door-list">
      {T.doors.items.map(([n, title, d, href], i) => (
        <li>
          <a href={p(href)}>
            <span class="n">{n}</span>
            <span class="t">{title}</span>
            <span class="d">
              {d} {i === 0 && <span class="mono ph">{T.doors.price}</span>}
            </span>
            <span class="a" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="descent wrap" data-depth="0" aria-labelledby="descent-h">
    <p class="kicker">{T.descent.kicker}</p>
    <h2 class="h2" id="descent-h">
      {T.descent.h2}
    </h2>
    <p class="lead">{T.descent.lead}</p>
    <ol class="stations">
      {T.descent.stations.map(([depth, meta, title, copy, link, href], i) => (
        <li class:list={['station', { dark: i >= 2 }]} data-depth={depthOf[i]}>
          <p class="dp">
            <b>{depth}</b>
            {T.descent.unit}
          </p>
          <div>
            <p class="meta">{meta}</p>
            <h3>{title}</h3>
          </div>
          <div>
            <p class="copy">{copy}</p>
            <a class="link" href={i === 3 ? '#deep' : p(href)}>
              {link}{' '}
              <span class="ar" aria-hidden="true">
                →
              </span>
            </a>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="deep dk" id="deep" data-depth="45" aria-labelledby="deep-h">
    <canvas class="sea" data-mode="deep" aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="deep-top">
        <div>
          <p class="kicker">{T.deep.kicker}</p>
          <h2 id="deep-h">{T.deep.h2}</h2>
          <p class="lead">{T.deep.lead}</p>
        </div>
        <div class="photo">
          <EditorialImage imageId="H04" sizes="(min-width: 1000px) 50vw, 100vw" />
          {DEMO_CONTENT && <span class="note">{T.deep.photoNote}</span>}
        </div>
      </div>
      <div class="gas">
        <table>
          <caption>{T.deep.caption}</caption>
          <thead>
            <tr>
              {T.deep.cols.map((c) => (
                <th scope="col">{c}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {T.deep.rows.map(([gas, ...cells]) => (
              <tr>
                <th scope="row">{gas}</th>
                {cells.map((c) => (
                  <td>{c}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="craft">
        {T.deep.craft.map(([k, b, s]) => (
          <li>
            <span class="k">{k}</span>
            <p>
              <b>{b}</b>
              <span>{s}</span>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="plan wrap" data-depth="45" aria-labelledby="plan-h">
    <div class="plan-top">
      <div>
        <p class="kicker">{T.plan.kicker}</p>
        <h2 class="h2" id="plan-h">
          {T.plan.h2}
        </h2>
      </div>
      <p class="lead">{T.plan.lead}</p>
    </div>
    <DiveProfile
      head={T.plan.head as [string, string]}
      aria={T.plan.aria}
      caption={T.plan.caption}
      units={T.plan.units}
      comma={locale === 'ru'}
    />
  </section>

  <SafetyStop
    kicker={T.stop.kicker}
    heading={T.stop.heading}
    lead={T.stop.lead}
    waiting={T.stop.waiting}
    running={T.stop.running}
    done={T.stop.done}
    cta={{ label: T.stop.cta, href: '#routes' }}
    label={T.stop.label}
    rules={T.stop.rules}
  />

  <section class="routes wrap" id="routes" data-depth="0" data-depth-end aria-labelledby="routes-h">
    <p class="kicker">{T.routes.kicker}</p>
    <h2 class="h2" id="routes-h">
      {T.routes.h2}
    </h2>
    <p class="lead">{T.routes.lead}</p>
    <ul class="route-grid">
      {T.routes.items.map(([img, alt, where, title, copy, need, href]) => (
        <li>
          <a class="route" href={p(href)}>
            {img ? (
              <EditorialImage
                name={img}
                alt={alt}
                ratio="4 / 5"
                sizes="(min-width: 1100px) 25vw, (min-width: 640px) 50vw, 100vw"
              />
            ) : (
              <span class="need-photo">{T.routes.needPhoto}</span>
            )}
            <span class="where">{where}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
            <span class="need">{need}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="events wrap" aria-labelledby="ev-h">
    <div class="two">
      <div>
        <p class="kicker">{T.events.kicker}</p>
        <h2 class="h2" id="ev-h">
          {T.events.h2}
        </h2>
      </div>
      <p class="lead">
        {T.events.lead} {DEMO_CONTENT && <span class="ph">{T.events.demo}</span>}
      </p>
    </div>
    <ol class="ev-list">
      {T.events.items.map(([dt, small, ty, title, place, href]) => (
        <li>
          <a href={p(href)}>
            <span class="dt">
              {dt}
              <small>{small}</small>
            </span>
            <span class="ty">{ty}</span>
            <b>{title}</b>
            <span class="pl">{place}</span>
            <span class="a" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="band-photo" aria-labelledby="crew-h">
    <EditorialImage imageId="H05" fill position="center 30%" />
    <div class="in">
      <h2 id="crew-h">{T.band.h2}</h2>
      <p>{T.band.p}</p>
      <a class="link" href={p('/crew')}>
        {T.band.link}{' '}
        <span class="ar" aria-hidden="true">
          →
        </span>
      </a>
    </div>
  </section>

  {DEMO_CONTENT && (
    <section class="reviews wrap" aria-labelledby="rv-h">
      <div class="two">
        <div>
          <p class="kicker">{T.reviews.kicker}</p>
          <h2 class="h2" id="rv-h">
            {T.reviews.h2}
          </h2>
        </div>
        <p class="lead">
          {T.reviews.lead} <span class="ph">{T.reviews.demo}</span>
        </p>
      </div>
      <ul class="rv-grid">
        {T.reviews.items.map(([q, what]) => (
          <li class="rv">
            <q>{q}</q>
            <div class="who">
              <i></i>
              <p>
                <b>{T.reviews.name}</b>
                <span>{what}</span>
              </p>
            </div>
          </li>
        ))}
      </ul>
      <div class="rv-src">
        <a class="chip-link" href={address.mapUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="map" />
          {T.reviews.yandex}
        </a>
        {contacts.vk && (
          <a class="chip-link" href={contacts.vk} target="_blank" rel="noopener noreferrer">
            <Icon name="vk" />
            {T.reviews.vk}
          </a>
        )}
      </div>
    </section>
  )}

  <section class="partners sec" aria-labelledby="pt-h">
    <div class="wrap two">
      <div>
        <p class="kicker">{T.partners.kicker}</p>
        <h2 class="h2" id="pt-h">
          {T.partners.h2}
        </h2>
      </div>
      <p class="lead">
        {T.partners.lead} {DEMO_CONTENT && <span class="ph">{T.partners.demo}</span>}
      </p>
    </div>
    <Partners rows={partnerRows} />
  </section>

  <section class="split" aria-label={`${T.workshop.kicker} · ${T.pro.kicker}`}>
    {[
      { ...T.workshop, tone: 'navy', href: '/service' },
      { ...T.pro, tone: 'paper', href: '/pro' },
    ].map((s) => (
      <div class:list={['panel', s.tone]}>
        <p class="kicker">{s.kicker}</p>
        <h2>{s.h2}</h2>
        <p class="lead">{s.lead}</p>
        <ul>
          {s.items.map((i) => (
            <li>{i}</li>
          ))}
        </ul>
        <a class="link" href={p(s.href)}>
          {s.link}{' '}
          <span class="ar" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    ))}
  </section>

  <section class="closing wrap" aria-labelledby="gift-h">
    <p class="kicker">{T.gift.kicker}</p>
    <h2 id="gift-h">{T.gift.h2}</h2>
    <div class="row">
      <p>{T.gift.p}</p>
      <a class="btn white" href={p('/gift')}>
        {T.gift.btn}{' '}
        <span class="ar" aria-hidden="true">
          →
        </span>
      </a>
    </div>
  </section>

  <DepthGauge unit={T.gauge.unit} zones={T.gauge.zones} spectrum={spectrum} />
</BaseLayout>

<script>
  import '../../scripts/sea';
</script>
