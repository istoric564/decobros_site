---
import { analytics, analyticsEnabled } from '../data/site';
import { localeFromUrl, localePath, t } from '../i18n';
import { ui } from '../i18n/ui';

const locale = localeFromUrl(Astro.url);
const config = JSON.stringify(analytics);
---

{analyticsEnabled && (
  <div class="consent" id="consent" role="region" aria-label={t(ui.consentLabel, locale)} hidden>
    <p>
      {t(ui.consentText, locale)}{' '}
      <a href={localePath(locale, '/privacy/')}>{t(ui.consentMore, locale)}</a>
    </p>
    <div class="consent__actions">
      <button type="button" data-consent="granted">
        {t(ui.consentAccept, locale)}
      </button>
      <button type="button" data-consent="denied" class="consent__secondary">
        {t(ui.consentDecline, locale)}
      </button>
    </div>
    <script is:inline type="application/json" id="analytics-config" set:html={config} />
  </div>
)}

{analyticsEnabled && <script>
  import { initAnalytics } from '../scripts/analytics';
  initAnalytics();
</script>}

<style>
  .consent {
    position: fixed;
    z-index: 50;
    inset: auto 16px 16px 16px;
    max-width: 560px;
    margin-inline: auto;
    padding: 18px 20px;
    background: var(--navy);
    color: var(--white);
    border: 1px solid var(--line-dark);
    box-shadow: 0 12px 32px rgb(0 0 0 / 35%);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .consent p {
    margin: 0 0 14px;
  }
  .consent a {
    color: var(--blue-soft);
  }
  .consent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .consent button {
    font: inherit;
    font-weight: 600;
    padding: 10px 18px;
    min-height: 44px;
    cursor: pointer;
    border: 1px solid var(--white);
    background: var(--white);
    color: var(--ink);
  }
  .consent .consent__secondary {
    background: transparent;
    color: var(--white);
  }
  .consent button:focus-visible,
  .consent a:focus-visible {
    outline: 2px solid var(--blue-soft);
    outline-offset: 2px;
  }
</style>
