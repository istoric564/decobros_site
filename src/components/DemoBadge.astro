---
import { DEMO_CONTENT } from '../data/site';
import { localeFromUrl, t } from '../i18n';
import { ui } from '../i18n/ui';
const locale = localeFromUrl(Astro.url);
---

{DEMO_CONTENT && <p class="demo">{t(ui.demo, locale)}</p>}
<style>
  .demo {
    display: inline-block;
    margin-bottom: 16px;
    padding: 4px 10px;
    border: 1px dashed #1f5f86;
    color: #1f5f86;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
  }
</style>
