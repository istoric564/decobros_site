---
import EditorialImage from './EditorialImage.astro';
interface Props {
  imageId: string;
  class?: string;
  id?: string;
  /** Use true only for the LCP image. */
  priority?: boolean;
  position?: string;
  /** Mobile hero: place the text over the image. */
  imageFirst?: boolean;
  /** Desktop min height (CSS value). */
  height?: string;
  /** Mobile image ratio (CSS value). */
  mobileRatio?: string;
}
const {
  imageId,
  class: className,
  id,
  priority = false,
  position = 'center',
  imageFirst = false,
  height = '380px',
  mobileRatio = '16 / 9',
} = Astro.props;
---

<section
  id={id}
  class:list={['band', className, { first: imageFirst }]}
  style={`--h:${height};--mr:${mobileRatio}`}
>
  <div class="bg">
    <EditorialImage fill imageId={imageId} priority={priority} position={position} sizes="100vw" />
  </div>
  <div class="container inner">
    <div class="text">
      <slot />
    </div>
  </div>
  <slot name="decoration" />
</section>

<style>
  .band {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--white);
    overflow: hidden;
  }
  .bg {
    position: relative;
    order: 2;
    aspect-ratio: var(--mr);
  }
  .first .bg {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }
  .first {
    min-height: clamp(440px, 115vw, 600px);
    justify-content: center;
    background: var(--ink);
    color: var(--white);
  }
  .first .bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(6 16 26 / 76%), rgb(6 16 26 / 32%) 55%, transparent),
      linear-gradient(0deg, rgb(6 16 26 / 22%), transparent 65%);
    pointer-events: none;
  }
  .first .inner {
    position: relative;
    z-index: 1;
  }
  .first .text {
    max-width: 34rem;
    padding-block: 48px;
  }
  .first .text :global(.btn) {
    background: var(--white);
    border-color: var(--white);
    color: var(--ink);
  }
  .first .text :global(.btn:hover) {
    background: var(--paper);
  }
  .first .text :global(.eyebrow) {
    color: var(--blue-soft);
  }
  .inner {
    order: 1;
  }
  .text {
    padding-block: 36px 32px;
  }
  @media (min-width: 960px) {
    .band {
      min-height: var(--h);
      justify-content: center;
      background: var(--white);
      color: var(--ink);
    }
    .bg {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }
    .bg::after,
    .first .bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        #fff 0%,
        rgb(255 255 255 / 0.98) 26%,
        rgb(255 255 255 / 0.8) 38%,
        rgb(255 255 255 / 0.24) 54%,
        rgb(255 255 255 / 0) 72%
      );
      pointer-events: none;
    }
    .inner {
      position: relative;
      z-index: 1;
      width: 100%;
    }
    .text,
    .first .text {
      max-width: 510px;
      padding-block: 48px;
    }
    .first .text :global(.btn) {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--white);
    }
    .first .text :global(.btn:hover) {
      background: var(--navy);
    }
    .first .text :global(.eyebrow) {
      color: var(--muted);
    }
  }
</style>
