---
import SocialLinks from './SocialLinks.astro';
import {
  brand,
  footerNav,
  legalNav,
  address,
  hours,
  legalEntity,
  analyticsEnabled,
} from '../data/site';
import { localeFromUrl, localePath, t } from '../i18n';
import { ui } from '../i18n/ui';

const locale = localeFromUrl(Astro.url);
const year = new Date().getFullYear();
const city = t({ ru: 'Новосибирск', en: 'Novosibirsk', zh: '新西伯利亚' }, locale);
const street = t(address.short, locale);
const open = hours[0];
---

<footer class="footer">
  <div class="row">
    <span>
      <b>{brand.short}</b> · {city}
    </span>
    <a href={address.mapUrl} target="_blank" rel="noopener noreferrer">
      {street}
    </a>
    <span>
      {t(open.days, locale)} {t(open.time, locale)}
    </span>
    <nav aria-label={t(ui.navFooter, locale)}>
      {footerNav.map((i) => (
        <a href={localePath(locale, i.href)}>{t(i.label, locale)}</a>
      ))}
      {legalNav.map((i) => (
        <a href={localePath(locale, i.href)}>{t(i.label, locale)}</a>
      ))}
    </nav>
    {analyticsEnabled && (
      <button type="button" class="cookie-btn" data-cookie-settings>
        {t(ui.cookieSettings, locale)}
      </button>
    )}
    <span class="age" role="img" aria-label={t(ui.ageMark, locale)} title={t(ui.ageMark, locale)}>
      18+
    </span>
    <SocialLinks class="footer-soc" />
  </div>
  <div class="legal">
    <p>{t(ui.trademarks, locale)}</p>
    <p>
      {t(ui.operator, locale)}: {t(legalEntity.operatorName, locale)} ·{' '}
      {t(legalEntity.operatorType, locale)} · {t(legalEntity.registrationData, locale)} ·{' '}
      <a href={`mailto:${legalEntity.privacyEmail}`}>{legalEntity.privacyEmail}</a>
    </p>
    <p>{t(ui.notOffer, locale)}</p>
    <p>
      © {year} {brand.full}. {t(ui.rights, locale)}
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--on-dark-3);
    border-top: 1px solid var(--line-dark);
    padding: 28px var(--g) 32px;
    font-size: 13px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 32px;
  }
  b {
    color: var(--on-dark);
    font-weight: 600;
  }
  a {
    text-decoration: none;
  }
  a:hover {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .row > a,
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 32px;
  }
  .cookie-btn {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  .cookie-btn:hover {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .age {
    padding: 2px 6px;
    border: 1px solid currentColor;
    border-radius: 4px;
    font-weight: 600;
  }
  .footer :global(.footer-soc) {
    margin-left: auto;
    color: var(--on-dark-2);
  }
  .legal {
    display: grid;
    gap: 4px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line-dark);
    font-size: 12px;
    line-height: 1.5;
  }
  .legal a {
    color: inherit;
    text-decoration: underline;
  }
</style>
