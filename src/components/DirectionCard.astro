---
import EditorialImage from './EditorialImage.astro';
import { localeFromUrl, t } from '../i18n';
import { ui } from '../i18n/ui';
interface Props {
  title: string;
  agency: string;
  copy: string;
  href: string;
  imageId: string;
}
const { title, agency, copy, href, imageId } = Astro.props;
const locale = localeFromUrl(Astro.url);
---

<article class="card">
  <div class="media">
    <EditorialImage
      fill
      imageId={imageId}
      position="70% center"
      sizes="(min-width: 960px) 50vw, 100vw"
    />
  </div>
  <div class="body">
    <div class="heading">
      <h3>{title}</h3>
      <p class="eyebrow">{agency}</p>
    </div>
    <p class="copy">{copy}</p>
    <a class="link-arrow" href={href}>
      {t(ui.learnMore, locale)} <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .card {
    position: relative;
    min-height: 230px;
    background: var(--white);
    border: 1px solid rgb(6 16 26 / 10%);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 3px 12px rgb(6 16 26 / 4%);
  }
  .media {
    position: absolute;
    inset: 0;
  }
  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #fff 0%, #fff 38%, rgb(255 255 255 / 0) 78%);
  }
  .body {
    position: relative;
    z-index: 1;
    max-width: 62%;
    padding: 24px 20px;
  }
  h3 {
    font-size: clamp(2rem, 3vw + 1rem, 3rem);
    letter-spacing: -0.04em;
  }
  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-bottom: 16px;
  }
  .eyebrow {
    max-width: 110px;
    font-size: 0.5625rem;
  }
  .copy {
    color: var(--muted);
    font-size: 0.875rem;
    margin-bottom: 8px;
  }
  @media (min-width: 960px) {
    .card {
      min-height: 230px;
    }
    .body {
      max-width: 58%;
      padding: 28px 32px;
    }
    .media::after {
      background: linear-gradient(90deg, #fff 0%, #fff 40%, rgb(255 255 255 / 0) 80%);
    }
  }
</style>
