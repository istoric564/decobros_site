---
import EditorialImage from './EditorialImage.astro';
import { localeFromUrl, t } from '../i18n';
import { ui } from '../i18n/ui';
interface Props {
  title: string;
  agency: string;
  copy: string;
  href: string;
  imageId: string;
}
const { title, agency, copy, href, imageId } = Astro.props;
const locale = localeFromUrl(Astro.url);
---

<article class="card reveal">
  <div class="media">
    <EditorialImage
      fill
      imageId={imageId}
      position="70% center"
      sizes="(min-width: 960px) 50vw, 100vw"
    />
  </div>
  <div class="body">
    <div class="heading">
      <h3>{title}</h3>
      <p class="eyebrow">{agency}</p>
    </div>
    <p class="copy">{copy}</p>
    <a class="link-arrow" href={href}>
      {t(ui.learnMore, locale)} <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    min-height: 250px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .media {
    position: absolute;
    inset: 0;
  }
  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--white) 0%,
      var(--white) 42%,
      rgb(255 255 255 / 92%) 52%,
      rgb(255 255 255 / 0) 86%
    );
    pointer-events: none;
  }
  .body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 67%;
    padding: 24px;
  }
  h3 {
    font-size: clamp(2.25rem, 3cqw, 3rem);
    letter-spacing: -0.04em;
    font-weight: 500;
  }
  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-bottom: 14px;
  }
  .eyebrow {
    max-width: 150px;
    font-size: 0.6875rem;
    line-height: 1.5;
    letter-spacing: 0.08em;
  }
  .copy {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 12px;
    text-wrap: pretty;
  }
  .link-arrow {
    margin-top: auto;
  }
  @media (max-width: 479px) {
    .body {
      width: 74%;
      padding: 24px 20px;
    }
    .media::after {
      background: linear-gradient(
        90deg,
        var(--white) 0%,
        var(--white) 48%,
        rgb(255 255 255 / 88%) 60%,
        transparent 100%
      );
    }
  }
</style>
