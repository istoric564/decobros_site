---
/** A numbered sequence read left to right: the path from zero, how a repair or an audit goes. */
interface Step {
  title: string;
  copy: string;
  /** Small label above the title, for example a program name. */
  meta?: string;
  link?: { label: string; href: string };
}
interface Props {
  items: Step[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<ol class:list={['steps', className]} data-stagger>
  {items.map((s, i) => (
    <li>
      <span class="n" aria-hidden="true">
        {String(i + 1).padStart(2, '0')}
      </span>
      {s.meta && <p class="eyebrow">{s.meta}</p>}
      <h3>{s.title}</h3>
      <p class="copy">{s.copy}</p>
      {s.link && (
        <a class="link-arrow" href={s.link.href}>
          {s.link.label} <span aria-hidden="true">→</span>
        </a>
      )}
    </li>
  ))}
</ol>

<style>
  .steps {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 24px 0 28px;
    border-bottom: 1px solid var(--line);
  }
  .n {
    margin-bottom: 18px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    /* Deep blue keeps AA contrast on paper as well as white. */
    color: #1f5f86;
    font-variant-numeric: tabular-nums;
  }
  .eyebrow {
    margin-bottom: 8px;
  }
  h3 {
    font-size: var(--fs-h3);
    margin-bottom: 12px;
  }
  .copy {
    max-width: 30rem;
    color: var(--muted);
    text-wrap: pretty;
  }
  .link-arrow {
    margin-top: auto;
    padding-top: 12px;
  }
  :global(.dark) .steps,
  :global(.dark) li {
    border-color: var(--line-dark);
  }
  :global(.dark) .copy {
    color: #b8c4cf;
  }
  :global(.dark) .n {
    color: var(--blue-soft);
  }
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 32px;
    }
  }
  @media (min-width: 1100px) {
    .steps {
      grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
      border-bottom: 1px solid var(--line);
    }
    li {
      padding-right: 8px;
      border-bottom: 0;
    }
    :global(.dark) .steps {
      border-color: var(--line-dark);
    }
  }
</style>
