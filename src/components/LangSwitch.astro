---
import { locales, htmlLang, localeNames, localeFromUrl, localePath, stripLocale, t } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const locale = localeFromUrl(Astro.url);
const base = stripLocale(Astro.url.pathname).replace(/(.)\/$/, '$1');
---

<nav class:list={['lang', className]} aria-label={t(ui.language, locale)}>
  <ul>
    {locales.map((l) => (
      <li>
        <a
          href={localePath(l, base)}
          hreflang={htmlLang[l]}
          lang={htmlLang[l]}
          aria-label={localeNames[l].full}
          aria-current={l === locale ? 'true' : undefined}
        >
          {localeNames[l].short}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 8px;
    border-radius: 4px;
    font: 500 13px var(--sans);
    text-decoration: none;
    opacity: 0.7;
  }
  a:hover {
    opacity: 1;
  }
  a[aria-current='true'] {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
</style>
