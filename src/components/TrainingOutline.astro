---
import { localeFromUrl, t } from '../i18n';
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
const locale = localeFromUrl(Astro.url);
const heading = t({ ru: 'На странице', en: 'On this page', zh: '本页内容' }, locale);
const sections = t({ ru: 'Разделы', en: 'Sections', zh: '章节' }, locale);
const overview = t({ ru: 'Обзор обучения', en: 'Training overview', zh: '培训概览' }, locale);
---

<aside class="training-outline">
  <nav aria-label={heading}>
    <p class="toc-heading">{heading}</p>
    <ol>
      {items.map((item) => (
        <li>
          <a href={'#' + item.id} data-toc-link>
            {item.label}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</aside>
<details class="training-mobile-outline">
  <summary>
    <span class="toc-heading">{sections}</span>
    <span class="toc-current" data-toc-current data-overview={overview}>
      {overview}
    </span>
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </summary>
  <nav aria-label={heading}>
    <ol>
      {items.map((item) => (
        <li>
          <a href={'#' + item.id} data-toc-link>
            {item.label}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</details>
<script>
  import '../scripts/training-outline';
</script>
<style>
  .training-outline {
    display: none;
  }
  .toc-heading {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 16px;
    border-left: 1px solid transparent;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: none;
    transition:
      color var(--motion-fast),
      border-color var(--motion-fast),
      background var(--motion-fast);
  }
  a:hover {
    color: var(--ink);
    background: var(--paper);
  }
  a[aria-current='location'] {
    color: var(--ink);
    border-left-color: var(--ink);
    font-weight: 500;
  }
  .training-mobile-outline {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--paper);
    border-block: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    padding: 10px var(--gutter);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .toc-current {
    flex: 1;
    min-width: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.4;
  }
  summary svg {
    flex-shrink: 0;
    transition: transform var(--motion-fast);
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
  .training-mobile-outline nav {
    position: absolute;
    inset: 100% 0 auto;
    max-height: 60dvh;
    overflow-y: auto;
    padding: 12px var(--gutter);
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 8px 24px rgb(6 16 26 / 8%);
  }
  @media (min-width: 1200px) {
    .training-mobile-outline {
      display: none;
    }
    .training-outline {
      display: block;
      padding: 44px 16px 44px var(--gutter);
      border-right: 1px solid var(--line);
    }
    .training-outline nav {
      position: sticky;
      top: 24px;
      max-height: calc(100dvh - 48px);
      overflow-y: auto;
    }
    .toc-heading {
      margin-bottom: 20px;
    }
    .training-outline ol {
      border-left: 1px solid var(--line);
    }
    .training-outline a {
      margin-left: -1px;
    }
  }
</style>
