---
/* Single-colour service marks and pictograms. They take the text colour. */
const paths = {
  telegram:
    '<path fill="currentColor" d="M21.4 3.6 2.9 10.7c-1.1.4-1 1.9.1 2.2l4.6 1.4 1.8 5.5c.3.9 1.4 1.1 2 .4l2.6-2.5 4.8 3.5c.8.6 1.9.1 2.1-.8l3.1-14.6c.3-1.1-.8-2-1.9-1.6ZM9.9 14.3l7.9-6.9-6.5 8.2-.4 3.1-1-4.4Z"/>',
  vk: '<path fill="currentColor" d="M12.9 18.2C6.6 18.2 3 13.9 2.8 6.6H6c.1 5.4 2.5 7.6 4.3 8.1V6.6h3v4.6c1.8-.2 3.7-2.3 4.4-4.6h3c-.5 2.8-2.6 4.9-4.1 5.8 1.5.7 3.9 2.6 4.8 5.8h-3.3c-.7-2.2-2.5-3.9-4.8-4.1v4.1h-.4Z"/>',
  whatsapp:
    '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M12 3.2a8.8 8.8 0 0 0-7.6 13.2L3.3 20.7l4.4-1.1A8.8 8.8 0 1 0 12 3.2Z"/><path fill="currentColor" d="M9.1 7.6c.2 0 .5 0 .6.4l.8 1.8c.1.3 0 .5-.1.7l-.6.7c-.1.2-.1.4 0 .6.6 1 1.4 1.8 2.5 2.4.2.1.4.1.6-.1l.7-.8c.2-.2.4-.2.7-.1l1.7.8c.3.1.4.4.4.6 0 1.1-.9 1.9-2 2-3.5.1-7.2-3.5-7-7 .1-1.1.9-2 1.7-2Z"/>',
  phone:
    '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M6.6 3.5h2.6l1.4 4.1-1.9 1.3a11 11 0 0 0 6.4 6.4l1.3-1.9 4.1 1.4v2.6a2.1 2.1 0 0 1-2.2 2.1C10.9 19.1 4.9 13.1 4.5 5.7a2.1 2.1 0 0 1 2.1-2.2Z"/>',
  email:
    '<rect x="3" y="5.5" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m3.8 7 8.2 6 8.2-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>',
  map: '<path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M12 21s-6.5-6.1-6.5-11a6.5 6.5 0 0 1 13 0c0 4.9-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.4" fill="none" stroke="currentColor" stroke-width="1.7"/>',
} as const;

export type IconName = keyof typeof paths;
interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={['ico', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  set:html={paths[name]}
/>
