---
/* Service marks without visible addresses: the label is for screen readers. */
import Icon, { type IconName } from './Icon.astro';
import { contactHref, contactItems, type contacts } from '../data/site';
import { localeFromUrl, t } from '../i18n';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const locale = localeFromUrl(Astro.url);
const order: (keyof typeof contacts)[] = ['telegram', 'vk', 'phone', 'email'];
const items = order
  .map((key) => ({
    key,
    href: contactHref(key),
    label: t(contactItems.find((c) => c.key === key)!.label, locale),
  }))
  .filter((i) => i.href);
const external = (key: string) => key === 'telegram' || key === 'vk';
---

<ul class:list={['soc', className]}>
  {items.map((i) => (
    <li>
      <a
        href={i.href!}
        aria-label={i.label}
        target={external(i.key) ? '_blank' : undefined}
        rel={external(i.key) ? 'noopener noreferrer' : undefined}
      >
        <Icon name={i.key as IconName} />
      </a>
    </li>
  ))}
</ul>

<style>
  .soc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 6px;
    border: 1px solid currentColor;
    color: inherit;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }
  a:hover {
    background: var(--white);
    color: var(--ink);
    border-color: var(--white);
  }
</style>
