---
import { brand } from '../data/site';
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<span class:list={['lockup', { dark }]}>
  <span class="short">{brand.short}</span>
  <span class="full">{brand.full}</span>
  <span class="desc">{brand.descriptor}</span>
</span>

<style>
  .lockup {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .short {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .full {
    font-size: 0.6875rem;
    color: var(--muted);
    margin-top: 1px;
  }
  .desc {
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-top: 2px;
  }
  .dark .full,
  .dark .desc {
    color: #9fb0bf;
  }
  @media (min-width: 768px) {
    .short {
      font-size: 1.625rem;
    }
    .full {
      font-size: 0.75rem;
    }
  }
</style>
