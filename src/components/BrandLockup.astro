---
import { Image } from 'astro:assets';
import { brand } from '../data/site';
import mark from '../assets/brand/logo-mark.png';
import markLight from '../assets/brand/logo-light-mark.png';
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<span class:list={['lockup', { dark }]}>
  <Image
    class="mark"
    src={dark ? markLight : mark}
    alt=""
    width={88}
    densities={[1, 2]}
    format="webp"
    loading="eager"
  />
  <span class="words">
    <span class="short">{brand.short}</span>
    <span class="full">{brand.full}</span>
    <span class="desc">{brand.descriptor}</span>
  </span>
</span>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: clamp(8px, 3vw, 12px);
  }
  .mark {
    width: clamp(44px, 15vw, 58px);
    height: auto;
    flex-shrink: 0;
  }
  .words {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .short {
    font-size: clamp(1.125rem, 5.4vw, 1.375rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .full {
    font-size: 0.6875rem;
    color: var(--muted);
    margin-top: 1px;
  }
  .desc {
    font-size: 0.5625rem;
    letter-spacing: 0.16em;
    color: var(--muted);
    margin-top: 2px;
  }
  .dark .full,
  .dark .desc {
    color: #9fb0bf;
  }
  @media (min-width: 768px) {
    .lockup {
      gap: 14px;
    }
    .mark {
      width: 72px;
    }
    .short {
      font-size: 1.625rem;
    }
    .full {
      font-size: 0.75rem;
    }
  }
</style>
