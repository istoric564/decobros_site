---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeFromUrl, localePath } from '../i18n';

const locale = localeFromUrl(Astro.url);
const T = {
  ru: {
    title: 'Страница не найдена',
    description: 'Такой страницы нет.',
    h1: ['Кажется, вы ушли', 'слишком глубоко.'],
    home: 'На главную',
  },
  en: {
    title: 'Page not found',
    description: 'This page does not exist.',
    h1: ['Looks like you went', 'a bit too deep.'],
    home: 'Go Home',
  },
  zh: {
    title: '页面未找到',
    description: '该页面不存在。',
    h1: ['看来您', '潜得太深了。'],
    home: '返回首页',
  },
}[locale];
---

<BaseLayout title={T.title} description={T.description} noindex>
  <section class="section dark">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>
        {T.h1[0]}
        <br />
        {T.h1[1]}
      </h1>
      <span class="rule"></span>
      <p class="more">
        <a class="btn light" href={localePath(locale, '/')}>
          {T.home}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: var(--fs-h1);
    margin-top: 16px;
  }
  .more {
    margin-top: 32px;
  }
  .section {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }
</style>
