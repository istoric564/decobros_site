---
import EditorialImage from './EditorialImage.astro';
/** The last entry of a page: one dark block that names the next step. */
interface Props {
  id: string;
  heading: string[];
  lead: string;
  cta: { label: string; href: string };
  eyebrow?: string;
  /** Image slot id from data/images.ts. */
  imageId?: string;
}
const { id, heading, lead, cta, eyebrow, imageId } = Astro.props;
---

<section class="section dark closing" aria-labelledby={id}>
  <div class:list={['container', { split: imageId }]}>
    <div class="split-text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={id}>
        {heading.map((line, i) => (
          <Fragment>
            {i > 0 && <br />}
            {line}
          </Fragment>
        ))}
      </h2>
      <span class="rule"></span>
      <p class="lead">{lead}</p>
      <slot />
      <a class="btn light" href={cta.href}>
        {cta.label} <span aria-hidden="true">→</span>
      </a>
    </div>
    {imageId && (
      <EditorialImage imageId={imageId} ratio="4 / 3" sizes="(min-width: 960px) 45vw, 100vw" />
    )}
  </div>
</section>

<style>
  h2 {
    font-size: var(--fs-h2);
  }
  .eyebrow {
    margin-bottom: 16px;
  }
  .closing .lead {
    margin-bottom: 28px;
  }
  /* The closing block sits on the ink footer; a deep hairline keeps them apart. */
  .closing {
    border-bottom: 1px solid var(--line-dark);
  }
  .split {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 960px) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: center;
      gap: clamp(40px, 5vw, 96px);
    }
  }
</style>
