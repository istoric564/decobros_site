---
import Band from './Band.astro';
interface Props {
  imageId: string;
  compact?: boolean;
  /** Headline lines. Each line is a separate row. */
  lines: string[];
  eyebrow?: string;
  copy?: string[];
  cta?: { label: string; href: string };
  /** Quieter second way forward, shown as a text link next to the button. */
  secondary?: { label: string; href: string };
}
const { imageId, lines, eyebrow, copy = [], cta, secondary, compact = false } = Astro.props;
---

<Band
  imageId={imageId}
  class={compact ? 'home-hero' : undefined}
  priority
  imageFirst
  position="70% center"
  height="clamp(480px, 30cqw, 640px)"
  mobileRatio="4 / 3"
>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>
    {lines.map((l) => (
      <span>{l}</span>
    ))}
  </h1>
  {copy.length > 0 && (
    <p class="copy">
      {copy.map((c) => (
        <span>{c}</span>
      ))}
    </p>
  )}
  {(cta || secondary) && (
    <div class="actions">
      {cta && (
        <a class="btn" href={cta.href}>
          {cta.label} <span aria-hidden="true">→</span>
        </a>
      )}
      {secondary && (
        <a class="link-arrow" href={secondary.href}>
          {secondary.label} <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  )}
  {compact && (
    <div slot="decoration" class="hero-caption" aria-hidden="true">
      <span>
        DEEPER
        <br />
        SKILLS
        <br />
        SAFER DIVES
        <br />
        BIGGER HORIZONS
      </span>
      <span class="caption-rule"></span>
    </div>
  )}
  {compact && (
    <div slot="decoration" class="hero-agencies" aria-hidden="true">
      <strong>
        SDI <span>&middot;</span> TDI
      </strong>
      <span>TRAINING / EXPEDITIONS / COMMUNITY</span>
    </div>
  )}
</Band>

<style>
  .eyebrow {
    margin-bottom: 16px;
  }
  h1 {
    font-size: var(--fs-display);
    letter-spacing: -0.04em;
    display: flex;
    flex-direction: column;
  }
  .btn {
    min-height: 44px;
    padding-inline: 24px;
    font-size: 14px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  h1 + .actions {
    margin-top: 24px;
  }
  .copy {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3em;
    max-width: 40rem;
    margin-block: 18px 20px;
    font-size: clamp(1rem, 1.2cqw, 1.125rem);
    line-height: 1.6;
    text-wrap: pretty;
  }
</style>
