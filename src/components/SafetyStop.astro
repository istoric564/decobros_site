---
/*
  The safety stop: three real minutes at five metres. While the timer runs, the club's
  standard is checked off, one rule every thirty seconds. Every rule reads at rest;
  the timer only adds the ticks.
*/
interface Props {
  kicker: string;
  heading: string;
  lead: string;
  waiting: string;
  running: string;
  done: string;
  cta: { label: string; href: string };
  label: string;
  /** [title, note, needs owner confirmation] */
  rules: [string, string, boolean?][];
}
const { kicker, heading, lead, waiting, running, done, cta, label, rules } = Astro.props;
const at = (i: number) => {
  const s = (i + 1) * 30;
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
};
---

<section class="stop dk" id="stop" data-depth="5" data-running={running} data-done={done}>
  <canvas class="sea" data-mode="ascent" aria-hidden="true"></canvas>
  <div class="wrap grid">
    <div>
      <p class="kicker">{kicker}</p>
      <h2>{heading}</h2>
      <p class="lead">{lead}</p>
      <div class="timer">
        <div class="t mono" aria-hidden="true">
          3:00
        </div>
        <div class="bar">
          <i></i>
        </div>
        <p class="state" aria-live="polite">
          {waiting}
        </p>
        <a class="btn out sm" href={cta.href}>
          {cta.label}
        </a>
      </div>
    </div>
    <ol class="rules" aria-label={label}>
      {rules.map(([title, note, ph], i) => (
        <li>
          <span class="at mono">{at(i)}</span>
          <p>
            <b class:list={{ ph }}>{title}</b>
            <span>{note}</span>
          </p>
          <span class="ck" aria-hidden="true"></span>
        </li>
      ))}
    </ol>
  </div>
</section>
<script>
  import '../scripts/safety-stop';
</script>

<style>
  .stop {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(72px, 10vw, 150px);
    color: var(--on-dark);
    background: linear-gradient(180deg, var(--navy) 0%, #0f3553 55%, #1d5f86 100%);
  }
  .grid {
    display: grid;
    gap: 40px 64px;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  h2 {
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    margin-top: 14px;
  }
  .lead {
    margin-top: 20px;
    color: var(--on-dark-2);
  }
  .timer {
    margin-top: clamp(28px, 4vw, 44px);
  }
  .t {
    font-size: clamp(5rem, 14vw, 11rem);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }
  .bar {
    position: relative;
    max-width: 34rem;
    height: 1px;
    margin-top: 18px;
    background: rgb(255 255 255 / 25%);
  }
  .bar i {
    position: absolute;
    left: 0;
    top: -1px;
    width: 0;
    height: 3px;
    background: var(--on-dark);
  }
  .state {
    min-height: 1.6em;
    margin: 14px 0 22px;
    font-size: 14px;
    color: var(--on-dark-2);
  }
  .rules {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid rgb(255 255 255 / 60%);
  }
  .rules li {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr) 24px;
    gap: 14px;
    align-items: baseline;
    padding-block: 18px;
    border-bottom: 1px solid rgb(255 255 255 / 14%);
  }
  .at {
    font-size: 13px;
    color: var(--on-dark-3);
  }
  .rules b {
    display: block;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .rules p span {
    display: block;
    margin-top: 2px;
    font-size: 14.5px;
    color: var(--on-dark-2);
  }
  .ck {
    position: relative;
    align-self: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 40%);
    transition:
      background 0.6s,
      border-color 0.6s;
  }
  .ck::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 3px;
    width: 5px;
    height: 10px;
    border: solid var(--ink);
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
    opacity: 0;
    transition: opacity 0.4s 0.2s;
  }
  .rules li.done .ck {
    background: var(--on-dark);
    border-color: var(--on-dark);
  }
  .rules li.done .ck::after {
    opacity: 1;
  }
</style>
