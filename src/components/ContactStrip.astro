---
import { contactItems, contactHref, contactFallback } from '../data/site';
import { localeFromUrl, t } from '../i18n';
import { ui } from '../i18n/ui';
interface Props {
  dark?: boolean;
  heading?: string;
}
const { dark = false, heading } = Astro.props;
const locale = localeFromUrl(Astro.url);
---

<div class:list={['strip', { dark }]}>
  {heading && <h2 class="h">{heading}</h2>}
  <ul>
    {contactItems.map((c) => {
      const href = contactHref(c.key);
      const label = t(c.label, locale);
      const external = c.key !== 'email' && c.key !== 'phone';
      return (
        <li>
          {href ? (
            <a
              href={href}
              rel={external ? 'noopener noreferrer' : undefined}
              target={external ? '_blank' : undefined}
            >
              <span class="label">{label}</span>
              <span class="note">{t(c.note, locale)}</span>
            </a>
          ) : (
            <span class="missing">
              <span class="label">{label}</span>
              <span class="note">{contactFallback[c.key] ?? t(ui.contentRequired, locale)}</span>
            </span>
          )}
        </li>
      );
    })}
  </ul>
</div>

<style>
  .h {
    font-size: var(--fs-h2);
    margin-bottom: 28px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .dark ul {
    border-color: var(--line-dark);
  }
  li {
    border-bottom: 1px solid var(--line);
  }
  .dark li {
    border-color: var(--line-dark);
  }
  a,
  .missing {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 72px;
    padding: 12px 0;
    text-decoration: none;
  }
  .label {
    font-size: 1.125rem;
    font-weight: 500;
  }
  .note {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .dark .note {
    color: #9fb0bf;
  }
  a:hover .label {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (min-width: 768px) {
    ul {
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--line);
    }
    .dark ul {
      border-bottom-color: var(--line-dark);
    }
    li {
      border-bottom: 0;
      padding-right: 24px;
    }
  }
  @media (min-width: 1100px) {
    ul {
      grid-template-columns: repeat(5, 1fr);
    }
  }
</style>
